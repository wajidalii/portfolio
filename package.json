{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate",
    "db:push": "node --env-file=.env.local node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=.env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file=.env.local node_modules/.bin/tsx src/db/seed.ts",
    "test:unit": "tsx --test tests/*.unit.test.ts",
    "test:integration": "tsx --test tests/*.integration.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.29",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.18.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
