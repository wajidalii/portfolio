# Postgres connection string. Local dev: `docker compose up -d`, then use
# postgres://portfolio:portfolio@localhost:5433/portfolio
# Production: a Neon (https://neon.tech) connection string.
DATABASE_URL=

# Password required to sign in at /admin/login.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Resend API key for the contact form. Get one at https://resend.com —
# the free tier's sandbox sender (onboarding@resend.dev) works without
# verifying a domain first.
RESEND_API_KEY=

# Optional: override the contact form's "from" address once a custom
# domain is verified in Resend. Defaults to the onboarding@resend.dev
# sandbox sender if unset.
CONTACT_FROM_EMAIL=

# Services inquiry protection. Required; generate a random >=32-character secret.
INQUIRY_RATE_LIMIT_SECRET=
# Optional ONLY when Netlify/platform strips and replaces this client header.
# Never trust a caller-supplied X-Forwarded-For by default.
INQUIRY_TRUSTED_IP_HEADER=
# Optional notification destination; defaults to the existing owner's address.
LEAD_NOTIFICATION_EMAIL=
# Off by default. Requires verified CONTACT_FROM_EMAIL and explicit prospect opt-in.
INQUIRY_ACKNOWLEDGMENTS_ENABLED=false
# A real free 20-minute event URL on https://cal.com or https://calendly.com.
# Empty => useful inquiry fallback; existing 15-minute portfolio event is unchanged.
CONSULTATION_BOOKING_URL=
# Optional local event bridge only; no provider/network transmission bundled.
NEXT_PUBLIC_CONVERSION_EVENTS_ENABLED=false
